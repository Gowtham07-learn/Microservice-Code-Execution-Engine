APP_NAME=code-execution-engine
API_HOST=0.0.0.0
API_PORT=8000

# memory = in-process queue + background worker (local/dev)
# redis  = shared queue for API + worker containers
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
JOB_RESULT_TTL_SECONDS=300
JOB_WAIT_TIMEOUT_SECONDS=30

MAX_CODE_BYTES=64000
MAX_TEST_CASES=20
MAX_TEST_CASE_BYTES=8192

TIMEOUT_SECONDS=2
MEMORY_LIMIT_MB=128
CPU_LIMIT=0.5
MAX_OUTPUT_BYTES=1048576
MAX_PROCESSES=32
